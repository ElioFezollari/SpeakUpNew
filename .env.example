# ── Blog source ────────────────────────────────────────────
# The admin site's published-posts endpoint. Read at build time only:
# the site is static, so new posts appear when the site is rebuilt.
BLOG_API_URL=https://admin.klinikelogopedie.com/api/posts

# Bearer token sent as `Authorization: Bearer <token>`.
# Store as an encrypted secret in DigitalOcean — never commit the real value.
BLOG_API_TOKEN=

# Optional: per-request timeout in ms (default 15000).
# BLOG_API_TIMEOUT_MS=15000

# Set to 1 to build from src/data/blog-fixtures.json when the API is
# unavailable. Useful for CI smoke builds; leave unset in production so a
# broken API fails the build instead of silently emptying the blog.
# BLOG_ALLOW_FIXTURES=1

# ── Contact form ───────────────────────────────────────────
# The admin site's enquiry endpoint. Called live from the visitor's browser,
# so this URL is public by design — it appears in the page source. There is no
# token: the endpoint must do its own abuse protection (docs/CONTACT-API.md).
# Without it the form renders but refuses to submit, and the build warns.
PUBLIC_CONTACT_API_URL=https://admin.klinikelogopedie.com/api/enquiries

# ── Booking ────────────────────────────────────────────────
# Base URL of the admin's booking API. The page calls two endpoints under it:
#   GET  {base}/availability   POST {base}/bookings
# Called from the visitor's browser at runtime — availability changes every
# time somebody books, so it cannot be baked into the build. Public by design;
# the endpoints must do their own rate limiting (docs/BOOKING-API.md).
# Unset -> the calendar runs in clearly-labelled demo mode and cannot submit.
PUBLIC_BOOKING_API_URL=https://admin.klinikelogopedie.com/api/booking

# ── Site ───────────────────────────────────────────────────
# Canonical origin, used for canonical URLs, hreflang and the sitemap.
SITE_URL=https://klinikelogopedie.com

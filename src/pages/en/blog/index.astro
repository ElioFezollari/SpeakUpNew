---
// English blog index, served at `/en/blog/`.
import Base from '../../../layouts/Base.astro';
import BlogIndex from '../../../components/BlogIndex.astro';
import { useCopy } from '../../../i18n/utils';

const { t } = useCopy(Astro.currentLocale);
---

<Base title={t.blog.title} description={t.blog.description}>
  <BlogIndex locale="en" />
</Base>

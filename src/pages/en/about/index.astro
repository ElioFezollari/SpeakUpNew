---
// English about page, served at `/en/about/`.
import Base from '../../../layouts/Base.astro';
import AboutPage from '../../../components/AboutPage.astro';
import { useCopy } from '../../../i18n/utils';

const { t } = useCopy(Astro.currentLocale);
---

<Base title={t.about.title} description={t.about.intro[0]}>
  <AboutPage locale="en" />
</Base>

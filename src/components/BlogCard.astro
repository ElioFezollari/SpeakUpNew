---
import { formatDate, isoDate, localePath, type Locale } from '../i18n/utils';
import { useCopy } from '../i18n/utils';

interface Props {
  post: {
    data: {
      slug: string;
      title: string;
      description: string;
      publishedAt: Date;
      readingMinutes: number;
      tags: string[];
      coverImage?: { url: string; alt: string };
      author?: { name: string; role?: string };
    };
  };
  locale: Locale;
  /** The first card on the index gets a larger treatment. */
  featured?: boolean;
}

const { post, locale, featured = false } = Astro.props;
const { t } = useCopy(locale);
const { data } = post;

const href = localePath(locale, `/blog/${data.slug}/`);
---

<article class:list={['card', { featured }]}>
  {
    data.coverImage && (
      <a class="cover" href={href} tabindex="-1" aria-hidden="true">
        {/* Cover images are remote URLs from the admin's media store, so they
            are plain <img> rather than optimised astro:assets images. */}
        <img
          src={data.coverImage.url}
          alt={data.coverImage.alt}
          loading="lazy"
          decoding="async"
        />
      </a>
    )
  }

  <div class="body">
    <div class="meta">
      <time datetime={isoDate(data.publishedAt)}>{formatDate(data.publishedAt, locale)}</time>
      <span class="dot" aria-hidden="true">·</span>
      <span>{data.readingMinutes} {t.blog.readingTime}</span>
    </div>

    <h3 class="title">
      <a href={href}>{data.title}</a>
    </h3>

    {data.description && <p class="excerpt">{data.description}</p>}

    <div class="foot">
      {data.author && <span class="author">{t.blog.by} {data.author.name}</span>}
      {
        data.tags.length > 0 && (
          <ul class="tags" aria-label={t.blog.tagsLabel}>
            {data.tags.slice(0, 3).map((tag) => (
              <li>{tag}</li>
            ))}
          </ul>
        )
      }
    </div>
  </div>
</article>

<style>
  .card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border-radius: var(--r-card);
    background: var(--card);
    border: var(--border-w) solid rgba(59, 47, 28, 0.12);
    box-shadow: var(--shadow-press);
    transition: transform 0.14s ease;
  }

  .card:hover {
    transform: translateY(-2px);
  }

  .cover {
    display: block;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: color-mix(in srgb, var(--sky) 18%, transparent);
  }

  .cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .body {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: clamp(18px, 2.4vw, 24px);
  }

  .meta {
    display: flex;
    align-items: center;
    gap: 7px;
    font-size: 12.5px;
    font-weight: 600;
    line-height: 1.4;
    color: rgba(59, 47, 28, 0.5);
  }

  .title {
    font-size: 21px;
    line-height: 1.15;
    color: var(--ink);
  }

  .title a {
    color: inherit;
    text-decoration: none;
  }

  /* The whole card is clickable, but only the title is a real link. */
  .title a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .card {
    position: relative;
  }

  .title a:hover {
    color: var(--eyebrow);
  }

  .excerpt {
    font-size: 14.5px;
    line-height: 1.64;
    color: var(--muted);
  }

  .foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    margin-top: 4px;
  }

  .author {
    font-size: 12.5px;
    font-weight: 600;
    color: var(--muted);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .tags li {
    padding: 4px 10px;
    border-radius: var(--r-pill);
    background: rgba(59, 47, 28, 0.06);
    font-size: 11.5px;
    font-weight: 600;
    color: var(--muted);
  }

  /* Featured card: image beside the copy on wide screens. */
  .featured {
    grid-column: 1 / -1;
  }

  @media (min-width: 760px) {
    .featured {
      flex-direction: row;
    }
    .featured .cover {
      flex: 0 0 46%;
      aspect-ratio: auto;
    }
    .featured .body {
      flex: 1;
      justify-content: center;
      padding: clamp(24px, 3vw, 36px);
    }
    .featured .title {
      font-size: clamp(24px, 2.4vw, 30px);
    }
    .featured .excerpt {
      font-size: 15.5px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .card:hover {
      transform: none;
    }
  }
</style>

---
import PhotoSlot from './PhotoSlot.astro';
import { useCopy, routePath, type Locale } from '../i18n/utils';
import { SITE } from '../site.config';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { t } = useCopy(locale);
const c = t.clinic;

// PLACEHOLDER: no photography has been supplied. Every slot below renders a
// labelled placeholder naming the file it expects; drop the file into
// src/assets/photos/ and it appears, optimised, with no code change.
const photos = c.photos;

// The first two get the wide treatment on desktop, so the gallery has a shape
// rather than reading as a uniform grid.
const featured = photos.slice(0, 2);
const rest = photos.slice(2);
---

<section class="clinic section">
  <div class="inner">
    <header class="head" data-reveal>
      <span class="eyebrow">{c.eyebrow}</span>
      <h1 class="title">{c.title}</h1>
      <p class="lede">{c.lede}</p>
      <p class="photo-note">{c.photoNote}</p>
    </header>

    <h2 class="sr-only">{c.galleryTitle}</h2>

    <div class="gallery">
      {
        featured.map((photo) => (
          <div class="cell wide" data-reveal>
            <PhotoSlot
              name={photo.name}
              alt={photo.alt}
              ratio="16 / 10"
              sizes="(max-width: 900px) 100vw, 50vw"
              priority
            />
            <figcaption class="cap">
              <strong>{photo.caption}</strong>
              <span>{photo.note}</span>
            </figcaption>
          </div>
        ))
      }
      {
        rest.map((photo) => (
          <div class="cell" data-reveal>
            <PhotoSlot
              name={photo.name}
              alt={photo.alt}
              ratio="4 / 3"
              sizes="(max-width: 640px) 100vw, (max-width: 1100px) 50vw, 33vw"
            />
            <figcaption class="cap">
              <strong>{photo.caption}</strong>
              <span>{photo.note}</span>
            </figcaption>
          </div>
        ))
      }
    </div>

    <section class="practical" aria-labelledby="practical-title">
      <h2 class="h2" id="practical-title" data-reveal>{c.practicalTitle}</h2>
      <dl class="facts" data-reveal-stagger>
        {
          c.practical.map((fact) => (
            <div class="fact">
              <dt>{fact.k}</dt>
              <dd class="v">{fact.v}</dd>
              <dd class="note">{fact.note}</dd>
            </div>
          ))
        }
      </dl>
    </section>

    <aside class="cta" data-reveal>
      <div>
        <h2 class="cta-title">{c.ctaTitle}</h2>
        <p class="cta-body">{c.ctaBody}</p>
      </div>
      <div class="cta-actions">
        <a class="btn btn-dark" href={routePath('booking', locale)}>{t.cta1}</a>
        <a class="phone" href={SITE.phone.href}>{SITE.phone.display}</a>
      </div>
    </aside>
  </div>
</section>

<style>
  .head {
    max-width: 62ch;
    margin-bottom: clamp(28px, 4vw, 44px);
  }

  .title {
    font-family: var(--font-display);
    font-weight: 600;
    letter-spacing: -0.015em;
    font-size: clamp(34px, 4.4vw, 54px);
    line-height: 1.05;
    color: var(--ink);
    margin-top: 13px;
    max-width: 18ch;
  }

  .lede {
    margin-top: 16px;
    font-size: 16.5px;
    line-height: 1.68;
    color: var(--muted);
  }

  /* Removed once real photography lands. */
  .photo-note {
    display: inline-block;
    margin-top: 18px;
    padding: 8px 15px;
    border-radius: var(--r-pill);
    background: rgba(229, 143, 111, 0.18);
    border: var(--border-w) solid rgba(59, 47, 28, 0.12);
    font-size: 12.5px;
    font-weight: 600;
    line-height: 1.5;
    color: var(--muted);
  }

  /* ── Gallery ───────────────────────────────────────────── */

  .gallery {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: var(--gap-cards);
  }

  .cell {
    grid-column: span 2;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .cell.wide {
    grid-column: span 3;
  }

  .cap {
    display: flex;
    flex-direction: column;
    gap: 3px;
    padding: 0 4px;
  }

  .cap strong {
    font-family: var(--font-display);
    font-weight: 600;
    letter-spacing: -0.015em;
    font-size: 17px;
    line-height: 1.2;
    color: var(--ink);
  }

  .cap span {
    font-size: 13.5px;
    line-height: 1.55;
    color: var(--muted);
  }

  /* ── Practical details ─────────────────────────────────── */

  .practical {
    margin-top: clamp(44px, 6vw, 76px);
  }

  .facts {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(12px, 2vw, 18px);
    margin: 26px 0 0;
  }

  .fact {
    padding: 20px;
    border-radius: var(--r-fact);
    background: var(--card);
    border: var(--border-w) solid var(--line);
  }

  dt {
    font-weight: 700;
    font-size: 11px;
    line-height: 1.4;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: rgba(59, 47, 28, 0.45);
  }

  .v {
    font-family: var(--font-display);
    font-weight: 600;
    letter-spacing: -0.015em;
    font-size: 21px;
    line-height: 1.2;
    color: var(--ink);
    margin: 9px 0 0;
  }

  .note {
    font-size: 13px;
    line-height: 1.6;
    color: var(--muted);
    margin: 8px 0 0;
  }

  /* ── Closing CTA ───────────────────────────────────────── */

  .cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: clamp(16px, 3vw, 32px);
    margin-top: clamp(44px, 6vw, 76px);
    padding: clamp(22px, 3vw, 32px);
    border-radius: var(--r-cta);
    background: var(--gold);
    box-shadow: var(--shadow-cta);
  }

  .cta-title {
    font-size: clamp(22px, 2.6vw, 30px);
    line-height: 1.1;
    color: var(--ink);
  }

  .cta-body {
    margin-top: 9px;
    max-width: 46ch;
    font-size: 15px;
    line-height: 1.65;
    color: rgba(59, 47, 28, 0.72);
  }

  .cta-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
  }

  .phone {
    font-family: var(--font-display);
    font-weight: 600;
    letter-spacing: -0.015em;
    font-size: 19px;
    line-height: 1.3;
    color: var(--ink);
    white-space: nowrap;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 6px;
  }

  .phone:hover {
    color: var(--deep);
    text-decoration: underline;
  }

  @media (max-width: 1100px) {
    .gallery {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
    .cell,
    .cell.wide {
      grid-column: span 2;
    }
    .facts {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .gallery {
      grid-template-columns: minmax(0, 1fr);
    }
    .cell,
    .cell.wide {
      grid-column: span 1;
    }
    .facts {
      grid-template-columns: minmax(0, 1fr);
    }
    .cta-actions {
      width: 100%;
    }
    .cta-actions :global(.btn) {
      flex: 1 1 100%;
    }
  }
</style>

---
import { useCopy } from '../i18n/utils';

const { t } = useCopy(Astro.currentLocale);

// The only stateful piece on the page. Sound 0 is rendered server-side so the
// section is complete and readable before (and without) JavaScript.
const sounds = t.sounds;
const initial = sounds[0];
---

<section id="toy" class="toy-section">
  <div class="inner">
    <div class="sec-head" data-reveal>
      <div>
        <span class="eyebrow">{t.eyebrow_toy}</span>
        <h2 class="h2">{t.toy_h2}</h2>
      </div>
      <p class="lede">{t.toy_p}</p>
    </div>

    <div class="toy-box" data-reveal>
      <div class="rail" role="group" aria-label={t.toy_pickLabel}>
        {
          sounds.map((sound, i) => (
            <button
              type="button"
              class:list={['sound-btn', { on: i === 0 }]}
              aria-pressed={i === 0 ? 'true' : 'false'}
              data-index={i}
              data-word={sound.word}
              data-spell={sound.spell}
              data-tip={sound.tip}
              data-age={sound.age}
            >
              {sound.letter}
            </button>
          ))
        }
      </div>

      <div class="stage">
        {/* `data-field` rather than `data-word` etc: the buttons above carry
            those same names as their payload, so a bare [data-word] lookup
            would match the first button instead of this display. */}
        <div class="bubble anim-pop" data-bubble>
          <div class="word" data-field="word">{initial.word}</div>
          {/* Rendered as one span per syllable so they can spell in one at a
              time. `data-field="spell"` stays the plain-text fallback target
              used when JS is off. */}
          <div class="spell" data-field="spell" data-spell-out>
            {
              initial.spell.split('-').map((part, i, all) => (
                <span class="syl" style={`--i:${i}`}>
                  {i < all.length - 1 ? `${part}-` : part}
                </span>
              ))
            }
          </div>
        </div>

        <div class="tip-col">
          <div class="tip-label">{t.toy_tip}</div>
          <p class="tip" data-field="tip">{initial.tip}</p>
          <div class="age" data-field="age">{initial.age}</div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const box = document.querySelector<HTMLElement>('.toy-box');
  if (box) {
    const buttons = box.querySelectorAll<HTMLButtonElement>('.sound-btn');
    const bubble = box.querySelector<HTMLElement>('[data-bubble]');
    const fields = {
      word: box.querySelector<HTMLElement>('[data-field="word"]'),
      spell: box.querySelector<HTMLElement>('[data-field="spell"]'),
      tip: box.querySelector<HTMLElement>('[data-field="tip"]'),
      age: box.querySelector<HTMLElement>('[data-field="age"]'),
    };

    const select = (button: HTMLButtonElement) => {
      for (const other of buttons) {
        const isTarget = other === button;
        other.classList.toggle('on', isTarget);
        other.setAttribute('aria-pressed', String(isTarget));
      }

      for (const [key, node] of Object.entries(fields)) {
        const value = button.dataset[key];
        if (!node || value === undefined) continue;

        if (key === 'spell') {
          // Rebuild the syllables so each one can animate in on its own beat.
          node.replaceChildren(
            ...value.split('-').map((part, i, all) => {
              const span = document.createElement('span');
              span.className = 'syl';
              span.style.setProperty('--i', String(i));
              span.textContent = i < all.length - 1 ? `${part}-` : part;
              return span;
            }),
          );
        } else {
          node.textContent = value;
        }
      }

      // Replay the pop animation by removing the class, forcing a style
      // recalculation and re-adding it. getBoundingClientRect() is used
      // rather than reading offsetWidth because a minifier may drop a bare
      // property read as dead code, but never a call.
      if (bubble) {
        bubble.classList.remove('anim-pop');
        bubble.getBoundingClientRect();
        bubble.classList.add('anim-pop');
      }
    };

    for (const button of buttons) {
      button.addEventListener('click', () => select(button));
    }
  }
</script>

<style>
  .toy-section {
    padding-top: clamp(38px, 5vw, 64px);
    padding-bottom: clamp(10px, 2vw, 20px);
  }

  .sec-head {
    margin-bottom: 26px;
  }

  .toy-box {
    display: grid;
    grid-template-columns: minmax(0, 88px) minmax(0, 1fr);
    gap: clamp(16px, 2.6vw, 28px);
    padding: clamp(18px, 2.6vw, 28px);
    border-radius: var(--r-toy);
    background: var(--card);
    border: var(--border-w) solid rgba(59, 47, 28, 0.12);
    box-shadow: var(--shadow-press);
  }

  .rail {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .sound-btn {
    font-family: var(--font-display);
    font-weight: 600;
    letter-spacing: -0.015em;
    font-size: 22px;
    line-height: 1;
    /* 46px tall: clears the 44px minimum tap target. */
    padding: 14px 0;
    min-height: 46px;
    border-radius: var(--r-sound);
    background: rgba(59, 47, 28, 0.05);
    color: var(--ink);
    border: var(--border-w) solid transparent;
    transition:
      background 0.16s ease,
      transform 0.24s cubic-bezier(0.34, 1.56, 0.64, 1),
      box-shadow 0.2s ease;
  }

  .sound-btn:hover {
    background: rgba(59, 47, 28, 0.1);
    transform: translateY(-2px);
  }

  .sound-btn:active {
    transform: translateY(2px) scale(0.97);
    transition-duration: 0.06s;
  }

  .sound-btn.on {
    background: var(--gold);
    border-color: rgba(59, 47, 28, 0.2);
    box-shadow: 0 4px 0 rgba(59, 47, 28, 0.2);
  }

  @media (prefers-reduced-motion: no-preference) {
    /* A quick shake the moment a letter becomes the active one. The JS
       toggles `.on`, which restarts the animation. */
    .sound-btn.on {
      animation: wiggle 0.42s ease;
    }
  }

  .stage {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
    gap: clamp(16px, 2.4vw, 26px);
    align-items: stretch;
  }

  .bubble {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: clamp(24px, 3.4vw, 40px) 20px;
    border-radius: var(--r-toy-bubble);
    background: var(--gold);
    min-height: 190px;
  }

  .word {
    font-family: var(--font-display);
    font-weight: 600;
    letter-spacing: -0.015em;
    font-size: clamp(30px, 3.8vw, 46px);
    line-height: 1.1;
    color: var(--ink);
    text-align: center;
    word-break: break-word;
  }

  .spell {
    font-weight: 700;
    font-size: 14.5px;
    line-height: 1.4;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(59, 47, 28, 0.55);
    text-align: center;
  }

  /* :global because the script rebuilds these spans on every letter change,
     and JS-created elements never receive Astro's scoping attribute. Anchored
     on .spell, which is in the template, so it stays effectively scoped. */
  .spell :global(.syl) {
    display: inline-block;
  }

  /* The syllables land one after another, as if being sounded out. */
  @media (prefers-reduced-motion: no-preference) {
    .spell :global(.syl) {
      animation: pop 0.34s cubic-bezier(0.34, 1.56, 0.64, 1) both;
      animation-delay: calc(0.16s + var(--i, 0) * 0.11s);
    }
  }

  .tip-col {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 9px;
    padding: 4px 4px 4px 0;
  }

  .tip-label {
    font-weight: 700;
    font-size: 11.5px;
    line-height: 1.4;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--eyebrow);
  }

  .tip {
    font-size: 16px;
    line-height: 1.66;
    color: var(--ink);
    max-width: 46ch;
  }

  .age {
    display: inline-block;
    align-self: flex-start;
    padding: 6px 13px;
    border-radius: var(--r-pill);
    background: rgba(59, 47, 28, 0.07);
    font-weight: 600;
    font-size: 12.5px;
    line-height: 1.4;
    color: var(--muted);
  }

  @media (max-width: 900px) {
    .toy-box {
      grid-template-columns: minmax(0, 1fr);
    }
    /* The letter rail becomes a horizontal row above the stage. */
    .rail {
      flex-direction: row;
      flex-wrap: wrap;
    }
    .sound-btn {
      flex: 1 1 56px;
      padding: 14px 10px;
    }
    .stage {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>

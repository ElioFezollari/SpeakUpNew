---
import { useCopy, routePath, type Locale } from '../i18n/utils';
import { SITE } from '../site.config';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { t } = useCopy(locale);

// Where a no-JavaScript submission lands, after the admin endpoint redirects
// here. The JS path shows the same message inline instead.
---

<section class="thanks">
  <div class="inner">
    <div class="card">
      <div class="mark" aria-hidden="true">★</div>
      <h1>{t.thanks.title}</h1>
      <p>{t.thanks.body}</p>

      <div class="actions">
        <a class="btn btn-dark" href={routePath('home', locale)}>{t.thanks.back}</a>
        <a class="phone" href={SITE.phone.href}>{SITE.phone.display}</a>
      </div>
    </div>
  </div>
</section>

<style>
  .thanks {
    padding-top: clamp(56px, 8vw, 110px);
    padding-bottom: clamp(56px, 8vw, 110px);
  }

  .card {
    max-width: 620px;
    margin: 0 auto;
    text-align: center;
    padding: clamp(30px, 5vw, 54px);
    border-radius: var(--r-toy);
    background: var(--card);
    border: var(--border-w) solid rgba(59, 47, 28, 0.12);
    box-shadow: var(--shadow-press);
  }

  .mark {
    display: grid;
    place-items: center;
    width: 68px;
    height: 68px;
    margin: 0 auto 20px;
    border-radius: 50%;
    background: var(--gold);
    color: var(--deep);
    font-size: 32px;
  }

  h1 {
    font-size: clamp(28px, 3.4vw, 40px);
    line-height: 1.08;
    color: var(--ink);
  }

  p {
    margin: 14px auto 0;
    max-width: 44ch;
    font-size: 16px;
    line-height: 1.68;
    color: var(--muted);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 14px;
    margin-top: 28px;
  }

  .phone {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 19px;
    color: var(--ink);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }

  .phone:hover {
    text-decoration: underline;
  }

  @media (prefers-reduced-motion: no-preference) {
    .mark {
      animation: pop-bounce 0.55s cubic-bezier(0.34, 1.56, 0.64, 1) both;
    }
  }
</style>

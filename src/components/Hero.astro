---
import Mascot from './Mascot.astro';
import { useCopy, localePath, routePath } from '../i18n/utils';

const { locale, t } = useCopy(Astro.currentLocale);
const home = localePath(locale, '/');
const contactHref = routePath('booking', locale);
---

<section class="hero">
  <div class="inner grid">
    <div class="col-text">
      <span class="pill">{t.pill}</span>

      {/* h1a / h1word / h1b are separate keys so each language can put the
          highlight pill on a grammatically sensible word. h1b may be empty. */}
      <h1>
        {t.h1a}
        <span class="highlight">{t.h1word}</span>
        {t.h1b}
      </h1>

      <p class="hero-p">{t.hero_p}</p>

      <div class="actions">
        <a class="btn btn-dark" href={contactHref}>{t.cta1}</a>
        <a class="btn btn-soft" href={`${home}#what`}>{t.cta2}</a>
      </div>

      <ul class="trust" data-reveal-stagger>
        {t.trust.map((label, i) => <li class={`chip chip-${i + 1}`}>{label}</li>)}
      </ul>
    </div>

    <Mascot />
  </div>
</section>

<style>
  .hero {
    padding-top: clamp(34px, 5vw, 60px);
    padding-bottom: clamp(30px, 4vw, 52px);
    overflow: hidden;
  }

  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    gap: clamp(24px, 4vw, 52px);
    align-items: center;
  }

  .pill {
    display: inline-block;
    padding: 8px 15px;
    border-radius: var(--r-pill);
    background: var(--card);
    border: var(--border-w) solid var(--line-strong);
    font-weight: 700;
    font-size: 12.5px;
    line-height: 1.3;
    color: var(--muted);
  }

  h1 {
    font-size: clamp(40px, 5.4vw, 68px);
    line-height: 1.04;
    color: var(--ink);
    margin-top: 20px;
    max-width: 15ch;
  }

  .highlight {
    display: inline-block;
    margin: 0 2px;
    padding: 2px 14px;
    border-radius: var(--r-pill);
    background: var(--gold);
    color: var(--ink);
    line-height: 1.12;
    /* Resting tilt from the design; `wobbly` rocks around it. */
    --r: -1.5deg;
    rotate: var(--r);
  }

  /* The headline pill rocks slowly, like a hand-stuck sticker. */
  @media (prefers-reduced-motion: no-preference) {
    .highlight {
      animation: wobbly 4.6s ease-in-out infinite;
    }

    .chip {
      transition: transform 0.24s cubic-bezier(0.34, 1.56, 0.64, 1);
    }

    .chip:hover {
      transform: translateY(-3px) rotate(-2deg);
    }
  }

  .hero-p {
    margin-top: 20px;
    max-width: 48ch;
    font-size: 16.5px;
    line-height: 1.68;
    color: var(--muted);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 28px;
  }

  .trust {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 26px 0 0;
    padding: 0;
    list-style: none;
  }

  .chip {
    padding: 7px 14px;
    border-radius: var(--r-pill);
    color: var(--ink);
    font-weight: 600;
    font-size: 12.5px;
    line-height: 1.4;
    white-space: nowrap;
  }

  .chip-1 {
    background: rgba(143, 185, 201, 0.22);
  }
  .chip-2 {
    background: rgba(157, 192, 139, 0.24);
  }
  .chip-3 {
    background: rgba(229, 143, 111, 0.2);
  }

  @media (max-width: 900px) {
    .grid {
      grid-template-columns: minmax(0, 1fr);
    }
    /* Mascot above the text on narrow screens: it sets the tone immediately
       and keeps the h1 close to the CTAs. */
    .col-text {
      order: 2;
    }
    h1 {
      max-width: 18ch;
    }
  }

  @media (max-width: 560px) {
    .chip {
      white-space: normal;
    }
    .actions :global(.btn) {
      flex: 1 1 100%;
    }
  }
</style>

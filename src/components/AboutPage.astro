---
import PhotoSlot from './PhotoSlot.astro';
import { useCopy, routePath, type Locale } from '../i18n/utils';
import { SITE } from '../site.config';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { t } = useCopy(locale);
const a = t.about;
---

<section class="about section">
  <div class="inner">
    <header class="head" data-reveal>
      <span class="eyebrow">{a.eyebrow}</span>
      <h1 class="title">{a.title}</h1>
    </header>

    <div class="intro" data-reveal>
      {a.intro.map((para) => <p>{para}</p>)}
    </div>

    <!-- Journey -->
    <section class="journey" aria-labelledby="journey-title">
      <div class="journey-box" data-reveal>
        <div>
          <h2 class="h2-light" id="journey-title">{a.journeyTitle}</h2>
          <p class="journey-lede">{a.journeyLede}</p>
        </div>

        <ul class="stats" data-reveal-stagger>
          {
            a.stats.map((stat) => (
              <li>
                <span class="stat-v">{stat.v}</span>
                <span class="stat-k">{stat.k}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <!-- More detail -->
    <section class="more-block" aria-labelledby="more-title">
      <h2 class="h2" id="more-title" data-reveal>{a.moreTitle}</h2>
      <div class="more-text" data-reveal>
        {a.more.map((para) => <p>{para}</p>)}
      </div>
    </section>

    <!-- Staff -->
    <section class="staff-block" aria-labelledby="staff-title">
      <div class="head" data-reveal>
        <h2 class="h2" id="staff-title">{a.staffTitle}</h2>
        <p class="lede">{a.staffLede}</p>
      </div>

      {
        a.staff.map((person) => (
          <article class="person" data-reveal>
            <div class="portrait">
              {/* PLACEHOLDER: staff portraits still to be supplied. */}
              <PhotoSlot
                name={person.photo}
                alt={person.alt}
                ratio="1 / 1"
                sizes="(max-width: 860px) 100vw, 300px"
              />
            </div>

            <div class="bio">
              {person.credential && <span class="credential">{person.credential}</span>}
              <h3>{person.name}</h3>
              <p class="role">{person.role}</p>
              {person.summary && <p class="summary">{person.summary}</p>}

              {
                person.groups.map((group) => (
                  <div class="group">
                    <h4>{group.title}</h4>
                    <ul>
                      {group.items.map((item) => (
                        <li>
                          <span class="dot" aria-hidden="true" />
                          <span>{item}</span>
                        </li>
                      ))}
                    </ul>
                  </div>
                ))
              }
            </div>
          </article>
        ))
      }
    </section>

    <aside class="cta" data-reveal>
      <div>
        <h2 class="cta-title">{t.cta_h2}</h2>
        <p class="cta-body">{t.cta_p}</p>
      </div>
      <div class="cta-actions">
        <a class="btn btn-dark" href={routePath('booking', locale)}>{t.cta1}</a>
        <a class="phone" href={SITE.phone.href}>{SITE.phone.display}</a>
      </div>
    </aside>
  </div>
</section>

<style>
  .head {
    max-width: 62ch;
  }

  .title {
    font-family: var(--font-display);
    font-weight: 600;
    letter-spacing: -0.015em;
    font-size: clamp(34px, 4.4vw, 54px);
    line-height: 1.05;
    color: var(--ink);
    margin-top: 13px;
    max-width: 18ch;
  }

  .intro {
    margin-top: clamp(22px, 3vw, 32px);
    max-width: 68ch;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .intro p {
    font-size: 16.5px;
    line-height: 1.72;
    color: var(--muted);
  }

  /* ── Journey ───────────────────────────────────────────── */

  .journey {
    margin-top: clamp(44px, 6vw, 76px);
  }

  .journey-box {
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
    gap: var(--gap-split);
    align-items: center;
    padding: clamp(24px, 3.4vw, 44px);
    border-radius: var(--r-panel);
    background: var(--deep);
  }

  .h2-light {
    font-family: var(--font-display);
    font-weight: 600;
    letter-spacing: -0.015em;
    font-size: clamp(26px, 3.2vw, 38px);
    line-height: 1.08;
    color: var(--paper);
    max-width: 14ch;
  }

  .journey-lede {
    margin-top: 14px;
    font-size: 15.5px;
    line-height: 1.7;
    color: rgba(255, 248, 232, 0.72);
    max-width: 46ch;
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .stats li {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 16px 14px;
    border-radius: var(--r-fact);
    background: rgba(255, 248, 232, 0.07);
    text-align: center;
  }

  .stat-v {
    font-family: var(--font-display);
    font-weight: 600;
    letter-spacing: -0.015em;
    font-size: clamp(24px, 3vw, 34px);
    line-height: 1;
    color: var(--gold);
  }

  .stat-k {
    font-size: 12.5px;
    line-height: 1.4;
    color: rgba(255, 248, 232, 0.72);
  }

  /* ── More ──────────────────────────────────────────────── */

  .more-block {
    margin-top: clamp(44px, 6vw, 76px);
  }

  .more-text {
    margin-top: 20px;
    max-width: 72ch;
    display: flex;
    flex-direction: column;
    gap: 15px;
  }

  .more-text p {
    font-size: 16px;
    line-height: 1.72;
    color: var(--muted);
  }

  /* ── Staff ─────────────────────────────────────────────── */

  .staff-block {
    margin-top: clamp(44px, 6vw, 76px);
  }

  .staff-block .lede {
    margin-top: 12px;
  }

  .person {
    display: grid;
    grid-template-columns: minmax(0, 300px) minmax(0, 1fr);
    gap: clamp(20px, 3vw, 40px);
    align-items: start;
    margin-top: clamp(24px, 3.5vw, 36px);
    padding: clamp(20px, 3vw, 32px);
    border-radius: var(--r-card);
    background: var(--card);
    border: var(--border-w) solid rgba(59, 47, 28, 0.12);
    box-shadow: var(--shadow-press);
  }

  .portrait {
    position: sticky;
    top: 92px;
  }

  .credential {
    display: block;
    font-weight: 700;
    font-size: 11px;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--eyebrow);
  }

  .bio h3 {
    font-size: clamp(23px, 2.4vw, 28px);
    line-height: 1.15;
    color: var(--ink);
    margin-top: 6px;
  }

  .role {
    margin-top: 5px;
    font-size: 15px;
    color: var(--muted);
  }

  .summary {
    margin-top: 12px;
    font-size: 15px;
    line-height: 1.65;
    color: var(--ink);
    font-weight: 600;
  }

  .group {
    margin-top: 24px;
  }

  .group h4 {
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 11px;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--eyebrow);
  }

  .group ul {
    margin: 12px 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 8px 22px;
  }

  .group li {
    display: flex;
    gap: 10px;
    align-items: flex-start;
    font-size: 14.5px;
    line-height: 1.58;
    color: var(--muted);
  }

  .dot {
    flex: none;
    width: 8px;
    height: 8px;
    margin-top: 7px;
    border-radius: 50%;
    background: var(--gold);
  }

  /* ── CTA ───────────────────────────────────────────────── */

  .cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: clamp(16px, 3vw, 32px);
    margin-top: clamp(44px, 6vw, 76px);
    padding: clamp(22px, 3vw, 32px);
    border-radius: var(--r-cta);
    background: var(--gold);
    box-shadow: var(--shadow-cta);
  }

  .cta-title {
    font-size: clamp(22px, 2.6vw, 30px);
    line-height: 1.1;
    color: var(--ink);
  }

  .cta-body {
    margin-top: 9px;
    max-width: 46ch;
    font-size: 15px;
    line-height: 1.65;
    color: rgba(59, 47, 28, 0.72);
  }

  .cta-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
  }

  .phone {
    font-family: var(--font-display);
    font-weight: 600;
    letter-spacing: -0.015em;
    font-size: 19px;
    color: var(--ink);
    white-space: nowrap;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 6px;
  }

  .phone:hover {
    color: var(--deep);
    text-decoration: underline;
  }

  @media (max-width: 900px) {
    .journey-box {
      grid-template-columns: minmax(0, 1fr);
    }
    .h2-light {
      max-width: 20ch;
    }
  }

  @media (max-width: 860px) {
    .person {
      grid-template-columns: minmax(0, 1fr);
    }
    .portrait {
      position: static;
      max-width: 260px;
    }
  }

  @media (max-width: 620px) {
    .stats {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .group ul {
      grid-template-columns: minmax(0, 1fr);
    }
    .cta-actions {
      width: 100%;
    }
    .cta-actions :global(.btn) {
      flex: 1 1 100%;
    }
  }
</style>

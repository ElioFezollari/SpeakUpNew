---
import { getCollection } from 'astro:content';
import BlogCard from './BlogCard.astro';
import { useCopy, type Locale } from '../i18n/utils';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { t } = useCopy(locale);

// Posts are per-locale: each one belongs to a single language and appears
// only in that language's index. Newest first.
const posts = (await getCollection('blog', ({ data }: { data: { locale: Locale } }) => data.locale === locale)).sort(
  (a: { data: { publishedAt: Date } }, b: { data: { publishedAt: Date } }) =>
    b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf(),
);

const [featured, ...rest] = posts;
---

<section class="blog-index section">
  <div class="inner">
    <header class="head">
      <span class="eyebrow">{t.blog.eyebrow}</span>
      <h1 class="title">{t.blog.title}</h1>
      <p class="lede">{t.blog.description}</p>
    </header>

    {
      posts.length === 0 ? (
        <p class="empty">{t.blog.empty}</p>
      ) : (
        <div class="grid">
          <BlogCard post={featured} locale={locale} featured />
          {rest.map((post: (typeof posts)[number]) => (
            <BlogCard post={post} locale={locale} />
          ))}
        </div>
      )
    }
  </div>
</section>

<style>
  .head {
    max-width: 62ch;
    margin-bottom: clamp(28px, 4vw, 44px);
  }

  .title {
    font-family: var(--font-display);
    font-weight: 600;
    letter-spacing: -0.015em;
    font-size: clamp(34px, 4.4vw, 54px);
    line-height: 1.05;
    color: var(--ink);
    margin-top: 13px;
    max-width: 18ch;
  }

  .lede {
    margin-top: 16px;
    font-size: 16.5px;
    line-height: 1.68;
    color: var(--muted);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--gap-cards);
    align-items: start;
  }

  .empty {
    padding: clamp(32px, 5vw, 56px);
    border-radius: var(--r-card);
    background: var(--card);
    border: var(--border-w) dashed rgba(59, 47, 28, 0.22);
    text-align: center;
    font-size: 15.5px;
    color: var(--muted);
  }

  @media (max-width: 980px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>

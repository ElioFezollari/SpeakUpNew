---
import PhotoSlot from './PhotoSlot.astro';
import { useCopy, routePath } from '../i18n/utils';

const { locale, t } = useCopy(Astro.currentLocale);
const s = t.services;

// Two audiences, three tabs each. The first tab of each group is rendered
// server-side so the content is readable before (and without) JavaScript.
const groups = [
  { id: 'children', ...s.children },
  { id: 'adults', ...s.adults },
];
---

<section id="services" class="section">
  <div class="inner">
    <div class="head" data-reveal>
      <span class="eyebrow">{s.eyebrow}</span>
      <h2 class="h2">{s.title}</h2>
    </div>

    {
      groups.map((group) => (
        <div class="group" data-service-group data-reveal>
          <h3 class="group-title">{group.title}</h3>

          <div class="tabs" role="tablist" aria-label={`${s.pickLabel}: ${group.title}`}>
            {group.tabs.map((tab, i) => (
              <button
                type="button"
                role="tab"
                class:list={['tab', { on: i === 0 }]}
                id={`tab-${group.id}-${i}`}
                aria-controls={`panel-${group.id}-${i}`}
                aria-selected={i === 0 ? 'true' : 'false'}
                tabindex={i === 0 ? 0 : -1}
              >
                {tab.tab}
              </button>
            ))}
          </div>

          <div class="panels">
            {group.tabs.map((tab, i) => (
              <div
                class="panel"
                role="tabpanel"
                id={`panel-${group.id}-${i}`}
                aria-labelledby={`tab-${group.id}-${i}`}
                hidden={i !== 0}
                tabindex="0"
              >
                <h4 class="panel-h">{tab.heading}</h4>
                <p class="panel-p">{tab.body}</p>
                {tab.list.length > 0 && (
                  <ul class="panel-list">
                    {tab.list.map((item) => (
                      <li>
                        <span class="dot" aria-hidden="true" />
                        <span>{item}</span>
                      </li>
                    ))}
                  </ul>
                )}
              </div>
            ))}
          </div>

          {/* PLACEHOLDER: three photographs per group, still to be supplied. */}
          <div class="shots">
            {group.photos.map((name) => (
              <PhotoSlot
                name={name}
                alt={group.title}
                ratio="1 / 1"
                sizes="(max-width: 700px) 45vw, 20vw"
              />
            ))}
          </div>
        </div>
      ))
    }

    <p class="all-ages" data-reveal>{s.allAges}</p>

    <a class="more" href={routePath('about', locale)} data-reveal>{s.more} →</a>
  </div>
</section>

<script>
  // Standard tablist behaviour: click to switch, arrow keys to move between
  // tabs, Home/End to jump. Each group is independent.
  for (const group of document.querySelectorAll<HTMLElement>('[data-service-group]')) {
    const tabs = [...group.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const panels = [...group.querySelectorAll<HTMLElement>('[role="tabpanel"]')];

    const select = (index: number, focus = true) => {
      tabs.forEach((tab, i) => {
        const on = i === index;
        tab.classList.toggle('on', on);
        tab.setAttribute('aria-selected', String(on));
        tab.tabIndex = on ? 0 : -1;
      });
      panels.forEach((panel, i) => {
        panel.hidden = i !== index;
      });
      if (focus) tabs[index]?.focus();
    };

    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => select(i, false));
      tab.addEventListener('keydown', (event) => {
        const last = tabs.length - 1;
        let next: number | null = null;
        if (event.key === 'ArrowRight') next = i === last ? 0 : i + 1;
        else if (event.key === 'ArrowLeft') next = i === 0 ? last : i - 1;
        else if (event.key === 'Home') next = 0;
        else if (event.key === 'End') next = last;
        if (next !== null) {
          event.preventDefault();
          select(next);
        }
      });
    });
  }
</script>

<style>
  .head {
    margin-bottom: clamp(26px, 3.5vw, 40px);
  }

  .group {
    padding: clamp(20px, 3vw, 34px);
    border-radius: var(--r-toy);
    background: var(--card);
    border: var(--border-w) solid rgba(59, 47, 28, 0.12);
    box-shadow: var(--shadow-press);
  }

  .group + .group {
    margin-top: var(--gap-cards);
  }

  .group-title {
    font-size: clamp(21px, 2.4vw, 27px);
    line-height: 1.15;
    color: var(--ink);
  }

  /* ── Tabs ──────────────────────────────────────────────── */

  .tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 18px;
  }

  .tab {
    padding: 11px 18px;
    min-height: 44px;
    border-radius: var(--r-pill);
    background: rgba(59, 47, 28, 0.05);
    border: var(--border-w) solid transparent;
    color: var(--ink);
    font-weight: 700;
    font-size: 13.5px;
    line-height: 1.3;
    transition:
      background 0.16s ease,
      transform 0.24s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .tab:hover {
    background: rgba(59, 47, 28, 0.1);
    transform: translateY(-2px);
  }

  .tab.on {
    background: var(--gold);
    border-color: rgba(59, 47, 28, 0.2);
    box-shadow: 0 4px 0 rgba(59, 47, 28, 0.2);
  }

  .tab:active {
    transform: translateY(2px);
    transition-duration: 0.06s;
  }

  .panels {
    margin-top: 22px;
  }

  .panel:focus-visible {
    outline: 3px solid var(--deep);
    outline-offset: 6px;
    border-radius: 8px;
  }

  @media (prefers-reduced-motion: no-preference) {
    .panel:not([hidden]) {
      animation: rise-in 0.4s cubic-bezier(0.22, 1, 0.36, 1) backwards;
    }
  }

  .panel-h {
    font-size: clamp(18px, 2vw, 22px);
    line-height: 1.2;
    color: var(--ink);
    max-width: 30ch;
  }

  .panel-p {
    margin-top: 12px;
    max-width: 62ch;
    font-size: 15.5px;
    line-height: 1.68;
    color: var(--muted);
  }

  .panel-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 9px 24px;
    margin: 18px 0 0;
    padding: 0;
    list-style: none;
  }

  .panel-list li {
    display: flex;
    gap: 11px;
    align-items: flex-start;
    font-size: 15px;
    line-height: 1.55;
    color: var(--ink);
  }

  .dot {
    flex: none;
    width: 9px;
    height: 9px;
    margin-top: 7px;
    border-radius: 50%;
    background: var(--gold);
  }

  /* ── The three photographs ─────────────────────────────── */

  .shots {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--gap-cards);
    margin-top: clamp(20px, 3vw, 30px);
  }

  /* ── Closing lines ─────────────────────────────────────── */

  .all-ages {
    margin: clamp(26px, 4vw, 40px) auto 0;
    max-width: 68ch;
    text-align: center;
    font-size: 16px;
    line-height: 1.7;
    color: var(--muted);
  }

  .more {
    display: block;
    width: fit-content;
    margin: 16px auto 0;
    padding: 12px 4px;
    min-height: 44px;
    font-weight: 700;
    font-size: 15px;
    text-decoration: none;
  }

  .more:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media (max-width: 700px) {
    .panel-list {
      grid-template-columns: minmax(0, 1fr);
    }
    .shots {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .shots > :last-child {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .tab:hover {
      transform: none;
    }
  }
</style>

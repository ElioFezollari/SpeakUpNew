---
import { useCopy, routePath } from '../i18n/utils';
import { SITE } from '../site.config';

const { locale, t } = useCopy(Astro.currentLocale);
---

<section id="contact" class="cta-section">
  <div class="inner">
    <div class="cta-box" data-reveal>
      <div class="mini-bubble" aria-hidden="true">
        <span class="eye anim-blink"></span><span class="eye anim-blink"></span>
      </div>

      <div class="cta-copy">
        <h2 class="cta-h2">{t.cta_h2}</h2>
        <p class="cta-p">{t.cta_p}</p>
      </div>

      <div class="cta-actions">
        <a class="btn btn-dark" href={routePath('booking', locale)}>{t.cta_btn}</a>
        <a class="phone" href={SITE.phone.href}>{SITE.phone.display}</a>
      </div>
    </div>
  </div>
</section>

<style>
  .cta-section {
    padding-top: clamp(40px, 5vw, 64px);
    padding-bottom: clamp(40px, 5vw, 64px);
  }

  .cta-box {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(16px, 3vw, 32px);
    align-items: center;
    padding: clamp(22px, 3vw, 32px);
    border-radius: var(--r-cta);
    background: var(--gold);
    box-shadow: var(--shadow-cta);
  }

  .mini-bubble {
    flex: none;
    width: 70px;
    height: 64px;
    border-radius: 52% 48% 46% 54% / 54% 52% 48% 46%;
    background: var(--deep);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 11px;
  }

  .eye {
    width: 9px;
    height: 13px;
    border-radius: 50%;
    background: var(--gold);
  }

  .cta-copy {
    flex: 1;
    min-width: 240px;
  }

  .cta-h2 {
    font-size: clamp(24px, 2.8vw, 34px);
    line-height: 1.1;
    color: var(--ink);
  }

  .cta-p {
    margin-top: 9px;
    font-size: 15px;
    line-height: 1.65;
    color: rgba(59, 47, 28, 0.72);
    max-width: 44ch;
  }

  .cta-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    align-items: center;
  }

  .phone {
    font-family: var(--font-display);
    font-weight: 600;
    letter-spacing: -0.015em;
    font-size: 19px;
    line-height: 1.3;
    color: var(--ink);
    white-space: nowrap;
    text-decoration: none;
    /* Keeps the tap target at 44px without changing the visual size. */
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 6px;
  }

  .phone:hover {
    color: var(--deep);
    text-decoration: underline;
  }

  @media (prefers-reduced-motion: no-preference) {
    /* The little mascot bobs, and grows a touch when the box is hovered. */
    .mini-bubble {
      animation: floaty 4.4s ease-in-out infinite;
      transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
    }

    .cta-box:hover .mini-bubble {
      transform: scale(1.08) rotate(-5deg);
    }

    .phone {
      transition: transform 0.24s cubic-bezier(0.34, 1.56, 0.64, 1);
    }

    .phone:hover {
      transform: scale(1.05);
    }
  }

  @media (max-width: 560px) {
    .cta-actions {
      width: 100%;
    }
    .cta-actions :global(.btn) {
      flex: 1 1 100%;
    }
  }
</style>

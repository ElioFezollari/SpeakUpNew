---
import { useCopy } from '../i18n/utils';

const { t } = useCopy(Astro.currentLocale);

const TOTAL = 10;
const EARNED = 6;
const stars = Array.from({ length: TOTAL }, (_, i) => ({ index: i, earned: i < EARNED }));
---

<section class="chart-section">
  <div class="inner">
    <div class="chart-box">
      <div class="chart-left" data-reveal>
        <span class="eyebrow-light">{t.eyebrow_chart}</span>
        <h2 class="h2-light">{t.chart_h2}</h2>
        <p class="chart-p">{t.chart_p}</p>
      </div>

      {/* The grid is decorative; the count is conveyed in text for AT.
          Stars land as the panel scrolls into view rather than on page load,
          so the reward actually gets seen. */}
      <div class="stars" aria-hidden="true" data-reveal>
        {
          stars.map((star) => (
            <div
              class:list={['star', star.earned ? 'earned' : 'empty']}
              style={`--delay:${(star.index * 0.09).toFixed(2)}s`}
            >
              {star.earned ? '★' : ''}
            </div>
          ))
        }
      </div>
      <p class="sr-only">{t.chart_sr}</p>
    </div>
  </div>
</section>

<style>
  .chart-section {
    padding-top: clamp(44px, 5.5vw, 72px);
    padding-bottom: clamp(8px, 1.5vw, 14px);
  }

  .chart-box {
    display: grid;
    grid-template-columns: minmax(0, 0.92fr) minmax(0, 1.08fr);
    gap: var(--gap-split);
    align-items: center;
    padding: clamp(24px, 3.4vw, 40px);
    border-radius: var(--r-panel);
    background: var(--deep);
  }

  .chart-left {
    min-width: 0;
  }

  .eyebrow-light {
    display: block;
    font-weight: 700;
    font-size: 11.5px;
    line-height: 1.4;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--gold);
  }

  .h2-light {
    font-family: var(--font-display);
    font-weight: 600;
    letter-spacing: -0.015em;
    font-size: clamp(28px, 3.2vw, 40px);
    line-height: 1.06;
    color: var(--paper);
    margin-top: 13px;
    max-width: 13ch;
  }

  .chart-p {
    margin-top: 14px;
    font-size: 15px;
    line-height: 1.7;
    color: rgba(255, 248, 232, 0.72);
    max-width: 46ch;
  }

  .stars {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: clamp(8px, 1.4vw, 14px);
  }

  .star {
    aspect-ratio: 1;
    border-radius: 50%;
    display: grid;
    place-items: center;
    font-size: clamp(18px, 2.2vw, 26px);
    line-height: 1;
  }

  .earned {
    background: var(--gold);
    color: var(--deep);
    border: 2px solid transparent;
  }

  .empty {
    background: rgba(255, 248, 232, 0.08);
    color: transparent;
    border: 2px dashed rgba(255, 248, 232, 0.28);
  }

  /* Stars land one after another, 0.09s apart, once the panel is in view.
     After landing, the earned ones keep a slow twinkle going. */
  @media (prefers-reduced-motion: no-preference) {
    /* Scoped under `.js` like every other reveal hide-rule: without it, a
       visitor with JavaScript off never gets `.is-in` and the stars would
       stay invisible forever. */
    :global(.js) .stars[data-reveal] .star {
      opacity: 0;
    }

    .stars[data-reveal].is-in .earned {
      animation:
        pop 0.42s cubic-bezier(0.34, 1.56, 0.64, 1) both var(--delay, 0s),
        twinkle 3.4s ease-in-out infinite calc(1.2s + var(--delay, 0s));
    }

    .stars[data-reveal].is-in .empty {
      animation: pop 0.34s ease both var(--delay, 0s);
    }

    .star {
      transition: transform 0.24s cubic-bezier(0.34, 1.56, 0.64, 1);
    }

    .earned:hover {
      transform: scale(1.16) rotate(-10deg);
    }
  }

  /* Opt the grid out of the generic reveal — the per-star animation above
     is the reveal, and running both looks muddy. The [data-reveal] hook
     stays so the observer still adds `.is-in`. */
  .stars[data-reveal],
  .stars[data-reveal].is-in {
    opacity: 1;
    animation: none;
  }

  @media (max-width: 900px) {
    .chart-box {
      grid-template-columns: minmax(0, 1fr);
    }
    /* The star grid deliberately stays 5 across when stacked. */
  }
</style>

---
import { useCopy, routePath, type Locale } from '../i18n/utils';
import { SITE } from '../site.config';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { t } = useCopy(locale);
const b = t.booking;

/**
 * The admin's booking API. Unlike the blog (fetched at build time) and the
 * contact form (a runtime POST only), booking needs a runtime **GET** as well:
 * availability changes every time somebody books, so it cannot be baked into
 * the static build.
 *
 * Two endpoints are expected under this base — see docs/BOOKING-API.md:
 *   GET  {base}/availability?from=&to=&service=
 *   POST {base}/bookings
 *
 * Public by necessity, so the endpoint must do its own abuse protection.
 */
const endpoint = import.meta.env.PUBLIC_BOOKING_API_URL ?? '';

if (!endpoint) {
  console.warn(
    '[booking] PUBLIC_BOOKING_API_URL is not set — the calendar will run in ' +
      'demo mode with generated availability, clearly labelled on the page. ' +
      'Set it before deploying (see docs/BOOKING-API.md).',
  );
}

---

<section class="booking section">
  <div class="inner">
    <header class="head" data-reveal>
      <span class="eyebrow">{b.eyebrow}</span>
      <h1 class="title">{b.title}</h1>
      <p class="lede">{b.lede}</p>
    </header>

    {
      !endpoint && (
        <div class="demo" role="status">
          <strong>{b.demoTitle}</strong>
          <span>{b.demoBody}</span>
        </div>
      )
    }

    <div
      class="layout"
      data-booking
      data-endpoint={endpoint}
      data-locale={locale}
    >
      <div class="flow" data-flow>
        {/* Service — a compact bar, not a numbered step: the calendar is the
            point of this page, so everything else stays out of its way. */}
        <div class="services-bar">
          <span class="services-label" id="svc-label">{b.serviceLabel}</span>
          <div class="services" role="radiogroup" aria-labelledby="svc-label">
            {
              b.services.map((service, i) => (
                <button
                  type="button"
                  role="radio"
                  class:list={['chip', { on: i === 0 }]}
                  aria-checked={i === 0 ? 'true' : 'false'}
                  tabindex={i === 0 ? 0 : -1}
                  data-service={service}
                >
                  {service}
                </button>
              ))
            }
          </div>
        </div>

        <div class="stage">
          {/* The calendar itself — the largest thing on the page. */}
          <div class="cal">
            <div class="cal-bar">
              <button type="button" class="nav" data-prev aria-label={b.prevMonth}>
                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                  <path d="M15 4.5 7.5 12l7.5 7.5" />
                </svg>
              </button>
              <h2 class="cal-month" data-month aria-live="polite"></h2>
              <button type="button" class="nav" data-next aria-label={b.nextMonth}>
                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                  <path d="M9 4.5 16.5 12 9 19.5" />
                </svg>
              </button>
            </div>

            <div class="weekdays" aria-hidden="true">
              {b.weekdays.map((day) => <span>{day}</span>)}
            </div>

            <div class="grid" role="grid" aria-label={b.calendarLabel} data-grid></div>

            <p class="cal-msg" data-cal-msg hidden></p>
          </div>

          {/* Times and the running summary sit beside it. */}
          <aside class="rail">
            <section class="rail-block" aria-labelledby="times-title">
              <h2 class="rail-title" id="times-title">{b.slotsLabel}</h2>
              <p class="hint" data-slots-hint>{b.pickDayFirst}</p>
              <div class="slots" role="radiogroup" aria-label={b.slotsLabel} data-slots></div>
            </section>

            <div class="summary-card">
              <h2 class="summary-title">{b.summaryTitle}</h2>
              <dl class="summary-list">
                <div><dt>{b.step1}</dt><dd data-sum-service>—</dd></div>
                <div><dt>{b.step2}</dt><dd data-sum-date>—</dd></div>
                <div><dt>{b.step3}</dt><dd data-sum-time>—</dd></div>
              </dl>
              <p class="summary-empty" data-sum-empty>{b.summaryEmpty}</p>
            </div>
          </aside>
        </div>

        {/* Revealed only once a service, day and time are all chosen, so the
            calendar owns the screen until there is something to confirm. */}
        <section class="details" data-details hidden aria-labelledby="details-title">
          <h2 class="details-title" id="details-title">{b.step4}</h2>

          <form class="form" data-form novalidate>
            <div class="pot" aria-hidden="true">
              <label>Fax<input type="text" name="fax" tabindex="-1" autocomplete="off" /></label>
            </div>
            <input type="hidden" name="renderedAt" value="" data-rendered-at />

            <div class="fields">
              <p class="field">
                <label for="bk-name">
                  {b.form.name} <span class="req">({b.form.required})</span>
                </label>
                <input id="bk-name" name="name" type="text" required autocomplete="name" />
                <span class="error" data-error-for="name" hidden></span>
              </p>

              <p class="field">
                <label for="bk-phone">
                  {b.form.phone} <span class="req">({b.form.required})</span>
                </label>
                <input
                  id="bk-phone"
                  name="phone"
                  type="tel"
                  required
                  inputmode="tel"
                  autocomplete="tel"
                />
                <span class="help">{b.form.phoneHelp}</span>
                <span class="error" data-error-for="phone" hidden></span>
              </p>

              <p class="field">
                <label for="bk-email">{b.form.email}</label>
                <input id="bk-email" name="email" type="email" autocomplete="email" />
                <span class="error" data-error-for="email" hidden></span>
              </p>

              <p class="field">
                <label for="bk-age">{b.form.childAge}</label>
                <input
                  id="bk-age"
                  name="childAge"
                  type="text"
                  placeholder={b.form.childAgePlaceholder}
                />
              </p>

              <p class="field field-wide">
                <label for="bk-notes">{b.form.notes}</label>
                <textarea id="bk-notes" name="notes" rows="3" placeholder={b.form.notesPlaceholder}
                ></textarea>
              </p>
            </div>

            <label class="consent">
              <input type="checkbox" name="consent" value="yes" required />
              <span>{b.form.consent}</span>
            </label>
            <span class="error" data-error-for="consent" hidden></span>

            <div class="actions">
              <button class="btn btn-dark" type="submit" data-submit disabled>
                {b.form.submit}
              </button>
              <a class="call" href={SITE.phone.href}>{SITE.phone.display}</a>
            </div>
          </form>
        </section>
      </div>

      {/* Result */}
      <div class="result" data-result hidden role="status" aria-live="polite">
        <div class="result-mark" aria-hidden="true">★</div>
        <h2 data-result-title></h2>
        <p data-result-body></p>
        <p class="reference" data-reference hidden>
          <span>{b.referenceLabel}</span><strong data-reference-value></strong>
        </p>
        <a class="btn btn-dark" href={routePath('home', locale)} data-result-home>
          {t.notFound.home}
        </a>
      </div>
    </div>
  </div>
</section>

<script
  is:inline
  define:vars={{
    STR: {
      loading: b.loading,
      loadError: b.loadError,
      retry: b.retry,
      unavailable: b.unavailable,
      today: b.today,
      selected: b.selected,
      noSlots: b.noSlots,
      monthEmpty: b.monthEmpty,
      pickDayFirst: b.pickDayFirst,
      sending: b.form.sending,
      submit: b.form.submit,
      successTitle: b.successTitle,
      successBody: b.successBody,
      errorTitle: b.errorTitle,
      errorBody: b.errorBody,
      takenTitle: b.takenTitle,
      takenBody: b.takenBody,
      notConfigured: b.notConfigured,
      weekdaysFull: b.weekdaysFull,
      months: b.months,
    },
  }}
>
  (() => {
    const root = document.querySelector('[data-booking]');
    if (!root) return;

    const endpoint = root.dataset.endpoint || '';
    const locale = root.dataset.locale || 'sq';
    const DEMO = !endpoint;

    const $ = (sel) => root.querySelector(sel);
    const grid = $('[data-grid]');
    const monthLabel = $('[data-month]');
    const calMsg = $('[data-cal-msg]');
    const slotsBox = $('[data-slots]');
    const slotsHint = $('[data-slots-hint]');
    const form = $('[data-form]');
    const submitBtn = $('[data-submit]');
    const result = $('[data-result]');

    // ── State ────────────────────────────────────────────────
    const state = {
      service: root.querySelector('[data-service]')?.dataset.service || '',
      month: new Date(new Date().getFullYear(), new Date().getMonth(), 1),
      date: null, // 'YYYY-MM-DD'
      time: null, // 'HH:MM'
      availability: new Map(), // dateKey -> string[]
      loading: false,
      // On first load, skip forward past fully-booked months rather than
      // showing an empty grid. Zeroed as soon as the visitor navigates by
      // hand, so their own choice of month is never overridden.
      autoSkip: 3,
    };

    /** Local calendar key. NOT toISOString(), which shifts the day in UTC+N. */
    const keyOf = (d) =>
      `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(
        d.getDate(),
      ).padStart(2, '0')}`;

    const parseKey = (key) => {
      const [y, m, d] = key.split('-').map(Number);
      return new Date(y, m - 1, d);
    };

    const todayKey = keyOf(new Date());

    /*
     * Month and weekday names come from the copy files, not Intl: a browser
     * without Albanian locale data silently falls back to English month names,
     * which is exactly what happened. The weekday letters were already
     * hardcoded this way; the months now match.
     */
    const fmtTime = (hhmm) => {
      const [h, m] = hhmm.split(':').map(Number);
      const mm = String(m).padStart(2, '0');
      if (locale === 'sq') return `${String(h).padStart(2, '0')}:${mm}`;
      const h12 = h % 12 === 0 ? 12 : h % 12;
      return `${h12}:${mm} ${h < 12 ? 'am' : 'pm'}`;
    };

    /** `E hënë, 14 shtator` / `Monday, 14 September`. */
    const fmtLong = (key) => {
      const d = parseKey(key);
      // Albanian writes months lower case in running text, capitalised only
      // as a heading.
      const monthName = STR.months[d.getMonth()];
      const month = locale === 'sq' ? monthName.toLowerCase() : monthName;
      const weekday = STR.weekdaysFull[(d.getDay() + 6) % 7];
      return `${weekday}, ${d.getDate()} ${month}`;
    };

    const fmtMonth = (d) => `${STR.months[d.getMonth()]} ${d.getFullYear()}`;

    // ── Availability ─────────────────────────────────────────

    /** Demo generator: weekdays only, a fixed slot pattern, some days full. */
    const demoAvailability = (from, to) => {
      const out = new Map();
      const cursor = new Date(from);
      const today = new Date();
      today.setHours(0, 0, 0, 0);
      while (cursor <= to) {
        const day = cursor.getDay();
        const key = keyOf(cursor);
        // Weekdays plus Saturday morning; nothing in the past.
        if (cursor >= today && day !== 0) {
          const seed = cursor.getDate();
          if (seed < 12 || seed > 16) {
            const slots =
              day === 6
                ? ['09:00', '09:45', '10:30', '11:15']
                : ['09:00', '09:45', '10:30', '11:15', '14:00', '14:45', '15:30', '16:15'];
            out.set(key, slots.filter((_, i) => (seed + i) % 5 !== 0));
          }
        }
        cursor.setDate(cursor.getDate() + 1);
      }
      return out;
    };

    /**
     * True when the month on screen has no bookable day.
     *
     * Only counts dates that actually fall inside the displayed month and are
     * not in the past — an API that returns days outside the requested range
     * (or stale past dates) must not make an empty month look populated.
     */
    function monthIsEmpty() {
      const prefix = `${state.month.getFullYear()}-${String(state.month.getMonth() + 1).padStart(2, '0')}-`;
      for (const [key, slots] of state.availability) {
        if (!key.startsWith(prefix)) continue;
        if (key < todayKey) continue;
        if (slots && slots.length > 0) return false;
      }
      return true;
    }

    /**
     * If the month that just loaded is completely full, move on to the next
     * one instead of presenting an empty grid. Returns true when it has taken
     * over and re-issued the load.
     */
    async function skipEmptyMonth() {
      if (!monthIsEmpty() || state.autoSkip <= 0) {
        // Nothing free and no skips left: say so rather than showing a blank.
        if (monthIsEmpty()) {
          calMsg.hidden = false;
          calMsg.classList.remove('is-error');
          calMsg.textContent = STR.monthEmpty;
        }
        return false;
      }
      state.autoSkip -= 1;
      state.month = new Date(state.month.getFullYear(), state.month.getMonth() + 1, 1);
      await loadMonth();
      return true;
    }

    async function loadMonth() {
      const from = new Date(state.month.getFullYear(), state.month.getMonth(), 1);
      const to = new Date(state.month.getFullYear(), state.month.getMonth() + 1, 0);

      state.loading = true;
      calMsg.hidden = false;
      calMsg.textContent = STR.loading;
      calMsg.classList.remove('is-error');
      renderGrid();

      if (DEMO) {
        state.availability = demoAvailability(from, to);
        state.loading = false;
        calMsg.hidden = true;
        if (await skipEmptyMonth()) return;
        renderGrid();
        return;
      }

      try {
        const url = new URL(endpoint.replace(/\/+$/, '') + '/availability');
        url.searchParams.set('from', keyOf(from));
        url.searchParams.set('to', keyOf(to));
        url.searchParams.set('service', state.service);
        url.searchParams.set('locale', locale);

        const res = await fetch(url, {
          headers: { Accept: 'application/json' },
          signal: AbortSignal.timeout(12000),
        });
        if (!res.ok) throw new Error(`HTTP ${res.status}`);
        const data = await res.json();

        state.availability = new Map(
          (data.days || []).map((d) => [d.date, Array.isArray(d.slots) ? d.slots : []]),
        );
        calMsg.hidden = true;
        state.loading = false;
        if (await skipEmptyMonth()) return;
      } catch (err) {
        console.error('[booking] availability failed:', err);
        state.availability = new Map();
        calMsg.hidden = false;
        calMsg.classList.add('is-error');
        calMsg.innerHTML = '';
        calMsg.append(STR.loadError + ' ');
        const again = document.createElement('button');
        again.type = 'button';
        again.className = 'retry';
        again.textContent = STR.retry;
        again.addEventListener('click', loadMonth);
        calMsg.append(again);
      } finally {
        state.loading = false;
        renderGrid();
      }
    }

    // ── Calendar grid ────────────────────────────────────────

    function renderGrid() {
      monthLabel.textContent = fmtMonth(state.month);
      grid.innerHTML = '';

      const year = state.month.getFullYear();
      const month = state.month.getMonth();
      const first = new Date(year, month, 1);
      // Monday-first: JS getDay() has Sunday as 0.
      const offset = (first.getDay() + 6) % 7;
      const daysInMonth = new Date(year, month + 1, 0).getDate();

      for (let i = 0; i < offset; i++) {
        const blank = document.createElement('span');
        blank.className = 'day blank';
        blank.setAttribute('role', 'presentation');
        grid.append(blank);
      }

      for (let day = 1; day <= daysInMonth; day++) {
        const date = new Date(year, month, day);
        const key = keyOf(date);
        const slots = state.availability.get(key) || [];
        const isPast = key < todayKey;
        const isToday = key === todayKey;
        const free = slots.length > 0 && !isPast;

        const cell = document.createElement('button');
        cell.type = 'button';
        cell.className = 'day';
        cell.dataset.date = key;
        cell.textContent = String(day);
        cell.setAttribute('role', 'gridcell');

        const parts = [`${day} ${fmtLong(key)}`];
        if (isToday) {
          cell.classList.add('is-today');
          parts.push(STR.today);
        }
        if (free) {
          cell.classList.add('has-slots');
          parts.push(`${slots.length}`);
        } else {
          cell.disabled = true;
          cell.classList.add('is-empty');
          parts.push(STR.unavailable);
        }
        if (key === state.date) {
          cell.classList.add('on');
          cell.setAttribute('aria-current', 'date');
          parts.push(STR.selected);
        }
        cell.setAttribute('aria-label', parts.join(', '));
        cell.tabIndex = key === state.date ? 0 : -1;

        grid.append(cell);
      }

      // Make sure something in the grid is always focusable.
      if (!grid.querySelector('[tabindex="0"]')) {
        const firstFree = grid.querySelector('.day.has-slots');
        if (firstFree) firstFree.tabIndex = 0;
      }
    }

    function selectDate(key) {
      // renderGrid() rebuilds every cell, which destroys the focused element.
      // If the choice came from the keyboard, put focus back on the newly
      // rendered cell so the visitor does not get dumped onto <body>.
      const hadFocus = grid.contains(document.activeElement);

      state.date = key;
      state.time = null;
      renderGrid();
      renderSlots();
      renderSummary();

      if (hadFocus) {
        grid.querySelector(`.day[data-date="${key}"]`)?.focus();
      }
    }

    grid.addEventListener('click', (e) => {
      const cell = e.target.closest('.day[data-date]');
      if (cell && !cell.disabled) selectDate(cell.dataset.date);
    });

    // Arrow-key navigation across the grid, as a date picker should have.
    grid.addEventListener('keydown', (e) => {
      const cell = e.target.closest('.day[data-date]');
      if (!cell) return;
      const step = { ArrowRight: 1, ArrowLeft: -1, ArrowDown: 7, ArrowUp: -7 }[e.key];
      if (step === undefined && e.key !== 'Home' && e.key !== 'End') return;
      e.preventDefault();

      const cells = [...grid.querySelectorAll('.day[data-date]')];
      const i = cells.indexOf(cell);
      let next;
      if (e.key === 'Home') next = 0;
      else if (e.key === 'End') next = cells.length - 1;
      else next = Math.min(cells.length - 1, Math.max(0, i + step));

      const target = cells[next];
      if (target) {
        cells.forEach((c) => (c.tabIndex = -1));
        target.tabIndex = 0;
        target.focus();
      }
    });

    $('[data-prev]').addEventListener('click', () => {
      state.autoSkip = 0; // the visitor is steering now
      state.month = new Date(state.month.getFullYear(), state.month.getMonth() - 1, 1);
      loadMonth();
    });
    $('[data-next]').addEventListener('click', () => {
      state.autoSkip = 0;
      state.month = new Date(state.month.getFullYear(), state.month.getMonth() + 1, 1);
      loadMonth();
    });

    // ── Time slots ───────────────────────────────────────────

    function renderSlots() {
      slotsBox.innerHTML = '';
      if (!state.date) {
        slotsHint.hidden = false;
        slotsHint.textContent = STR.pickDayFirst;
        return;
      }
      const slots = state.availability.get(state.date) || [];
      if (slots.length === 0) {
        slotsHint.hidden = false;
        slotsHint.textContent = STR.noSlots;
        return;
      }
      slotsHint.hidden = true;

      for (const slot of slots) {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'slot';
        btn.setAttribute('role', 'radio');
        btn.setAttribute('aria-checked', String(slot === state.time));
        btn.dataset.time = slot;
        btn.textContent = fmtTime(slot);
        if (slot === state.time) btn.classList.add('on');
        btn.addEventListener('click', () => {
          state.time = slot;
          renderSlots();
          renderSummary();
        });
        slotsBox.append(btn);
      }
    }

    // ── Service chips ────────────────────────────────────────

    const chips = [...root.querySelectorAll('[data-service]')];
    chips.forEach((chip, i) => {
      chip.addEventListener('click', () => {
        chips.forEach((c) => {
          c.classList.toggle('on', c === chip);
          c.setAttribute('aria-checked', String(c === chip));
          c.tabIndex = c === chip ? 0 : -1;
        });
        state.service = chip.dataset.service;
        renderSummary();
        // Availability can differ per service, so reload the month.
        loadMonth();
      });
      chip.addEventListener('keydown', (e) => {
        const dir = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
        if (!dir) return;
        e.preventDefault();
        const next = chips[(i + dir + chips.length) % chips.length];
        next.click();
        next.focus();
      });
    });

    // ── Summary ──────────────────────────────────────────────

    let detailsShown = false;

    function renderSummary() {
      $('[data-sum-service]').textContent = state.service || '—';
      $('[data-sum-date]').textContent = state.date ? fmtLong(state.date) : '—';
      $('[data-sum-time]').textContent = state.time ? fmtTime(state.time) : '—';
      const complete = Boolean(state.service && state.date && state.time);
      $('[data-sum-empty]').hidden = complete;
      submitBtn.disabled = !complete;

      // Keep the calendar the whole page until there is something to confirm,
      // then reveal the form and bring it into view the first time only.
      const details = $('[data-details]');
      details.hidden = !complete;
      if (complete && !detailsShown) {
        detailsShown = true;
        details.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
      }
      if (!complete) detailsShown = false;
    }

    // ── Submission ───────────────────────────────────────────

    const stamp = $('[data-rendered-at]');
    if (stamp) stamp.value = String(Date.now());

    const showError = (name, message) => {
      const node = root.querySelector(`[data-error-for="${name}"]`);
      if (!node) return;
      node.textContent = message;
      node.hidden = !message;
    };

    const validate = () => {
      let firstBad = null;
      for (const field of form.querySelectorAll('input[name], textarea[name]')) {
        if (field.type === 'hidden' || field.name === 'fax') continue;
        const ok = field.checkValidity();
        showError(field.name, ok ? '' : field.validationMessage);
        field.setAttribute('aria-invalid', ok ? 'false' : 'true');
        if (!ok && !firstBad) firstBad = field;
      }
      if (firstBad) firstBad.focus();
      return !firstBad;
    };

    const finish = (kind, reference) => {
      const titles = { ok: STR.successTitle, error: STR.errorTitle, taken: STR.takenTitle };
      const bodies = { ok: STR.successBody, error: STR.errorBody, taken: STR.takenBody };
      $('[data-result-title]').textContent = titles[kind];
      $('[data-result-body]').textContent = bodies[kind];
      const refBox = $('[data-reference]');
      if (kind === 'ok' && reference) {
        $('[data-reference-value]').textContent = reference;
        refBox.hidden = false;
      } else {
        refBox.hidden = true;
      }
      result.classList.toggle('is-error', kind !== 'ok');
      $('[data-result-home]').hidden = kind !== 'ok';
      result.hidden = false;
      if (kind === 'ok') {
        root.querySelector('[data-flow]').hidden = true;
      }
      result.scrollIntoView({ block: 'center', behavior: 'smooth' });
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!validate()) return;

      if (DEMO) {
        console.warn('[booking] PUBLIC_BOOKING_API_URL is not set — nothing was sent.');
        $('[data-result-title]').textContent = STR.errorTitle;
        $('[data-result-body]').textContent = STR.notConfigured;
        result.classList.add('is-error');
        $('[data-reference]').hidden = true;
        $('[data-result-home]').hidden = true;
        result.hidden = false;
        result.scrollIntoView({ block: 'center', behavior: 'smooth' });
        return;
      }

      submitBtn.disabled = true;
      submitBtn.textContent = STR.sending;

      try {
        const payload = Object.fromEntries(new FormData(form).entries());
        payload.service = state.service;
        payload.date = state.date;
        payload.time = state.time;
        payload.locale = locale;

        const res = await fetch(endpoint.replace(/\/+$/, '') + '/bookings', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify(payload),
        });

        if (res.status === 409) {
          // Somebody took the slot first. Reload and let them pick again.
          finish('taken');
          state.time = null;
          await loadMonth();
          renderSlots();
          renderSummary();
          submitBtn.disabled = false;
          submitBtn.textContent = STR.submit;
          return;
        }
        if (!res.ok) throw new Error(`HTTP ${res.status}`);

        const data = await res.json().catch(() => ({}));
        finish('ok', data.reference);
      } catch (err) {
        console.error('[booking] submit failed:', err);
        finish('error');
        submitBtn.disabled = false;
        submitBtn.textContent = STR.submit;
      }
    });

    form.addEventListener('input', (e) => {
      const field = e.target;
      if (field.name && field.checkValidity()) {
        showError(field.name, '');
        field.setAttribute('aria-invalid', 'false');
      }
    });

    // ── Go ───────────────────────────────────────────────────
    renderSummary();
    renderSlots();
    loadMonth();
  })();
</script>


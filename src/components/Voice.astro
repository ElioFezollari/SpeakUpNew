---
import { useCopy } from '../i18n/utils';

const { t } = useCopy(Astro.currentLocale);
const v = t.voice;
---

<section class="voice-section">
  <div class="inner">
    <div class="box" data-reveal>
      <div class="left">
        <span class="eyebrow-light">{v.eyebrow}</span>
        <h2 class="h2-light">{v.title}</h2>
        <p class="lede-light">{v.lede}</p>
      </div>

      <ul class="items" data-reveal-stagger>
        {
          v.items.map((item, i) => (
            <li>
              <span class="num" aria-hidden="true">
                {i + 1}
              </span>
              <span>{item}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .voice-section {
    padding-top: clamp(44px, 5.5vw, 72px);
    padding-bottom: clamp(8px, 1.5vw, 14px);
  }

  .box {
    display: grid;
    grid-template-columns: minmax(0, 0.92fr) minmax(0, 1.08fr);
    gap: var(--gap-split);
    align-items: center;
    padding: clamp(24px, 3.4vw, 44px);
    border-radius: var(--r-panel);
    background: var(--deep);
  }

  .left {
    min-width: 0;
  }

  .eyebrow-light {
    display: block;
    font-weight: 700;
    font-size: 11.5px;
    line-height: 1.4;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--gold);
  }

  .h2-light {
    font-family: var(--font-display);
    font-weight: 600;
    letter-spacing: -0.015em;
    font-size: clamp(28px, 3.4vw, 42px);
    line-height: 1.06;
    color: var(--paper);
    margin-top: 13px;
    max-width: 14ch;
  }

  .lede-light {
    margin-top: 14px;
    font-size: 15.5px;
    line-height: 1.7;
    color: rgba(255, 248, 232, 0.72);
    max-width: 40ch;
  }

  .items {
    display: flex;
    flex-direction: column;
    gap: 14px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .items li {
    display: flex;
    gap: 15px;
    align-items: flex-start;
    padding: 16px 18px;
    border-radius: var(--r-fact);
    background: rgba(255, 248, 232, 0.07);
    font-size: 15.5px;
    line-height: 1.6;
    color: rgba(255, 248, 232, 0.9);
  }

  .num {
    flex: none;
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: var(--gold);
    color: var(--deep);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 15px;
    line-height: 1;
  }

  @media (max-width: 900px) {
    .box {
      grid-template-columns: minmax(0, 1fr);
    }
    .h2-light {
      max-width: 18ch;
    }
  }
</style>
